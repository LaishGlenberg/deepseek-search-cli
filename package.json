{
  "name": "deepseek-search-cli",
  "version": "1.2.0",
  "description": "CLI for DeepSeek's native web search and page fetch APIs",
  "type": "module",
  "bin": {
    "dsearch": "dist/index.js"
  },
  "main": "dist/sdk.js",
  "types": "dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:watch": "npm run build",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e --mode e2e",
    "test:live": "vitest run tests/live",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "bump": "npm version --no-git-tag-version"
  },
  "keywords": [
    "deepseek",
    "search",
    "web-search",
    "cli",
    "ai",
    "rag",
    "fetch",
    "llm"
  ],
  "author": "LaishGlenberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaishGlenberg/deepseek-search-cli.git"
  },
  "homepage": "https://github.com/LaishGlenberg/deepseek-search-cli#readme",
  "bugs": {
    "url": "https://github.com/LaishGlenberg/deepseek-search-cli/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
